# Copy this file to `.env` and fill in your EmailJS credentials.
# Dashboard: https://dashboard.emailjs.com/admin
#   Service ID  → Email Services → your service
#   Template ID → Email Templates → your template
#   Public Key  → Account → General
#
# The template should reference {{from_name}}, {{from_email}} and {{message}}.
# These values are public by design (they ship in the client bundle), which is
# how EmailJS works — restrict allowed origins in the EmailJS dashboard.

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
